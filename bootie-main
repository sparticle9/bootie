#!/bin/sh
# bootie-main — target-resident reinstall entrypoint (debi.sh ergonomics).
# Runs ON the machine being reinstalled: no controller, no ansible, no
# inventory. Staging, approval and the boot into the live env happen here;
# everything after the reboot is target-resident by design (initramfs
# autostart -> write -> personalize -> in-env verify -> osboot -> firstboot
# -> post-upgrade reboot).
#
# Privilege model: root, or any user with sudo (passwordless preferred for a
# smooth run; sudo caches one password prompt otherwise). Nothing else needs
# to exist beyond a basic Linux with sshd — missing pieces are reported and,
# on apt-based systems, installed after confirmation.
#
# This script is normally executed from the self-extracting bootie bundle;
# it expects its engine directory next to $0.
set -eu

# system administration tools (grub-reboot, mkinitramfs) live in sbin, which
# a normal user's PATH on Debian excludes — probe with a complete PATH.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}
export PATH

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
bootie_version=$(cat "$here/VERSION" 2>/dev/null || echo dev)

. "$here/engine/prompt.sh"

usage() {
    cat >&2 <<'EOF'
usage: bootie [command] [options]

commands:
  install        reinstall this machine (the default when no command is given)
  rescue         boot into a non-destructive RAM rescue environment
                 (defaults to debian-initramfs)
  check          read-only probe: facts, plan fit and the support envelope —
                 nothing is installed, staged or mutated
  version        print the bootie version
  help           this text

options:
  --manifest NAME        bundled manifest to install (default omarchy-4.5)
  --manifest-file PATH   use a manifest file instead of a bundled one
  --key FILE             public keys to carry into the new OS and the liveenv
                         rescue SSH access (authorized_keys format,
                         several lines allowed)
  --password             install only: prompt interactively for the managed
                         user's password (hidden input; leave blank to
                         auto-generate a 10-char alphanumeric password)
  --password-file PATH   install only: read the managed user's password from
                         PATH (first line; avoids exposing passwords in argv)
  --accept-risk CLASS    explicitly accept a fail-closed risk class; repeatable
                         and comma-separated classes are accepted. currently
                         supported: drivers — unverified mixed/non-virtio
                         storage/NIC drivers, only when provider console
                         recovery is available
  --mirror URL           override the HTTPS release directory URL for
                         checksum-indexed releases (Debian/Ubuntu); works with
                         check and install. exact resolved source URLs are
                         always printed for double confirmation
  --rescue-backend alpine-kexec
                         opt into experimental Alpine RAM rescue
  --rescue-console TTY   Alpine rescue only: acknowledge access to ttyS0 or tty1
  --console-only         rescue only: acknowledge provider-console-only access
                         when no SSH keys are available
  --clean                rescue only: remove the rescue initramfs, GRUB entry,
                         initramfs hook, and staged rescue files
  --no-reboot            install/rescue: stage without rebooting
                         Alpine assembles and discards its temporary image

access after the reinstall — always printed for review before anything
mutates:
  with --key     the given keys are carried forward
  without --key  the keys already authorized on this machine (invoking user
                 and root) are carried forward — usually exactly the access
                 you already use
manifest users may additionally declare their own keys or a password hash.
when no key material exists at all, access is password/console only and the
liveenv rescue shell is unreachable over ssh — the review says so plainly,
and with no authentication at all the run refuses to proceed.

rescue mode is explicitly non-destructive: it resolves no manifest or OS
installation artifact, and stages no write command or autostart. The default
uses one-shot GRUB. Alpine uses a one-time kexec handoff. With no SSH keys it
refuses to proceed unless --console-only acknowledges provider console access.

bootie runs as root or as a normal user with sudo. everything after the one
typed approval is unattended: reboot into the RAM live env, write,
personalize, osboot, first-boot system upgrade, final reboot.
EOF
}

# --- command dispatch ---------------------------------------------------------
cmd=install
case "${1:-}" in
    install) shift ;;
    rescue) cmd=rescue; shift ;;
    check) cmd=check; shift ;;
    version) echo "bootie $bootie_version"; exit 0 ;;
    help|-h|--help) usage; exit 0 ;;
    "") ;;
    -*) ;;  # bare options mean install — debi.sh ergonomics
    *) echo "unknown command: $1" >&2; usage; exit 2 ;;
esac

key=
manifest=omarchy-4.5
manifest_set=
manifest_file=
no_reboot=
accept_risks=
mirror=
password_prompt=
password_file=
console_only=
rescue_clean=
rescue_backend=debian-initramfs
rescue_console=
while [ $# -gt 0 ]; do
    case "$1" in
        --key)
            [ $# -ge 2 ] || { echo "--key requires a FILE argument" >&2; usage; exit 2; }
            key=$2; shift 2 ;;
        --password)
            password_prompt=1; shift ;;
        --password-file)
            [ $# -ge 2 ] || { echo "--password-file requires a PATH argument" >&2; usage; exit 2; }
            [ -n "$2" ] || { echo "--password-file requires a non-empty PATH" >&2; usage; exit 2; }
            password_file=$2; shift 2 ;;
        --manifest)
            [ $# -ge 2 ] || { echo "--manifest requires a NAME argument" >&2; usage; exit 2; }
            manifest=$2; manifest_set=1; shift 2 ;;
        --manifest-file)
            [ $# -ge 2 ] || { echo "--manifest-file requires a PATH argument" >&2; usage; exit 2; }
            manifest_file=$2; shift 2 ;;
        --accept-risk)
            [ $# -ge 2 ] || { echo "--accept-risk requires a CLASS argument" >&2; usage; exit 2; }
            case "$2" in
                ''|,*|*,|*,,*|*[!A-Za-z0-9_,-]*)
                    echo "invalid --accept-risk CLASS: $2" >&2; exit 2 ;;
            esac
            accept_risks="${accept_risks:+$accept_risks,}$2"; shift 2 ;;
        --mirror)
            [ $# -ge 2 ] || { echo "--mirror requires a URL argument" >&2; usage; exit 2; }
            [ -n "$2" ] || { echo "--mirror requires a non-empty URL" >&2; exit 2; }
            mirror=$2; shift 2 ;;
        --no-reboot) no_reboot=1; shift ;;
        --rescue-backend)
            [ "${2:-}" = alpine-kexec ] || { echo "expected --rescue-backend alpine-kexec" >&2; exit 2; }
            rescue_backend=$2; shift 2 ;;
        --rescue-console)
            case "${2:-}" in
                ttyS0|tty1) rescue_console=$2; shift 2 ;;
                *) echo "expected --rescue-console ttyS0 or tty1" >&2; exit 2 ;;
            esac ;;
        --console-only) console_only=1; shift ;;
        --clean) rescue_clean=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "unknown option: $1" >&2; usage; exit 2 ;;
    esac
done
[ -z "$key" ] || [ -f "$key" ] || { echo "key file not found: $key" >&2; exit 2; }
if [ -n "$password_prompt" ] && [ -n "$password_file" ]; then
    echo "--password and --password-file cannot be used together" >&2
    usage
    exit 2
fi
if [ "$cmd" != install ]; then
    [ -z "$password_prompt" ] || { echo "--password only applies to install" >&2; usage; exit 2; }
    [ -z "$password_file" ] || { echo "--password-file only applies to install" >&2; usage; exit 2; }
fi
[ -z "$password_file" ] || [ -f "$password_file" ] || { echo "password file not found: $password_file" >&2; exit 2; }
if [ "$cmd" != rescue ]; then
    [ -z "$console_only" ] || { echo "--console-only only applies to rescue" >&2; usage; exit 2; }
    [ -z "$rescue_clean" ] || { echo "--clean only applies to rescue" >&2; usage; exit 2; }
fi
if [ "$cmd" = rescue ]; then
    [ -z "$manifest_set" ] || { echo "--manifest does not apply to rescue" >&2; usage; exit 2; }
    [ -z "$manifest_file" ] || { echo "--manifest-file does not apply to rescue" >&2; usage; exit 2; }
    [ -z "$mirror" ] || { echo "--mirror does not apply to rescue" >&2; usage; exit 2; }
fi
if [ "$cmd" != install ] && [ "$cmd" != rescue ] && [ -n "$no_reboot" ]; then
    echo "--no-reboot only applies to install and rescue" >&2
    usage
    exit 2
fi

if [ "$rescue_backend" = alpine-kexec ]; then
    [ "$cmd" = rescue ] || { echo "Alpine backend applies only to rescue" >&2; exit 2; }
    [ -z "$accept_risks" ] || { echo "Alpine rescue allows no risk override" >&2; exit 2; }
    if [ -n "$rescue_clean" ]; then
        echo "Alpine rescue uses temporary staging; no persistent rescue files to remove"
        exit 0
    fi
    [ -n "$rescue_console" ] || { echo "Alpine rescue requires a working --rescue-console" >&2; exit 2; }
elif [ -n "$rescue_console" ]; then
    echo "--rescue-console requires the Alpine backend" >&2
    exit 2
fi

# interactive answers come from the controlling terminal whenever one
# exists — in `curl ... | sh` mode stdin IS the script itself, so stdin is
# only a valid answer source when there is no terminal (automation feeding
# answers through a pipe). sets REPLY; nonzero when no answer is possible.
prompt_read() {
    bootie_prompt_read
}

confirm() {
    printf '%s [y/N] ' "$1" >&2
    prompt_read "" || return 1
    reply=$REPLY
    [ "$reply" = y ] || [ "$reply" = Y ] || [ "$reply" = yes ]
}

# --- privilege model ----------------------------------------------------------
if [ "$(id -u)" = 0 ]; then
    SUDO=
    privmodel=root
elif command -v sudo >/dev/null 2>&1; then
    SUDO=sudo
    privmodel="normal user with sudo"
    if [ "$cmd" = install ] || [ "$cmd" = rescue ]; then
        # sudo -n true succeeds cleanly for NOPASSWD users even when they also
        # belong to a password-requiring group like %sudo (where `sudo -v`
        # still demands a password). Fall back to `sudo -v` only when needed.
        sudo -n true 2>/dev/null || sudo -v
    fi
else
    echo "need root or a user with sudo — cannot run bootie" >&2
    exit 1
fi
echo "bootie $bootie_version — privilege model: $privmodel"

# rescue cleanup is intentionally independent of dependencies and facts: it
# must remain available even on a half-broken host after the operator returns.
if [ "$cmd" = rescue ] && [ -n "$rescue_clean" ]; then
    echo "==> cleaning rescue staging"
    $SUDO rm -f /boot/initrd-bootie-rescue.img \
        /etc/grub.d/41_bootie_rescue \
        /etc/initramfs-tools/hooks/bootie-rescue
    $SUDO rm -rf /usr/local/share/bootie-rescue
    grub_editenv=$(command -v grub-editenv || true)
    if [ -n "$grub_editenv" ] && [ -f /boot/grub/grubenv ]; then
        if $SUDO "$grub_editenv" /boot/grub/grubenv list 2>/dev/null | grep -qx 'next_entry=BOOTIE rescue (one-shot)'; then
            $SUDO "$grub_editenv" /boot/grub/grubenv unset next_entry || {
                echo "failed to clear the armed rescue next_entry" >&2; exit 1; }
        fi
    fi
    if command -v update-grub >/dev/null 2>&1; then
        $SUDO update-grub >/dev/null 2>&1 || {
            echo "grub config regeneration failed" >&2; exit 1; }
    elif command -v grub2-mkconfig >/dev/null 2>&1; then
        $SUDO grub2-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || {
            echo "grub config regeneration failed" >&2; exit 1; }
    fi
    echo "rescue cleanup complete: removed rescue initramfs, GRUB entry, hook, and staged files"
    exit 0
fi

# --- dependencies ---------------------------------------------------------------
# python3: facts/plan/staging. grub + initramfs-tools: the liveenv boot path.
# curl/ca-certificates: artifact resolution. check mode only reports them.
if [ "$rescue_backend" = alpine-kexec ]; then
    for dep in python3 curl bsdtar kexec systemctl ip findmnt blkid; do
        command -v "$dep" >/dev/null 2>&1 || { echo "missing Alpine rescue dependency: $dep" >&2; exit 1; }
    done
    [ "$(uname -s):$(uname -m)" = Linux:x86_64 ] || { echo "Alpine rescue requires x86_64 Linux" >&2; exit 1; }
else
missing=
for dep in python3 curl mkinitramfs; do
    command -v "$dep" >/dev/null 2>&1 || missing="$missing $dep"
done
if ! command -v grub-reboot >/dev/null 2>&1 && ! command -v grub2-reboot >/dev/null 2>&1; then
    missing="$missing grub-reboot"
fi
if [ -n "$missing" ]; then
    echo "missing target dependencies:$missing"
    if [ "$cmd" = check ]; then
        echo "(check mode: not installing anything — install would offer to apt-get these)"
    elif command -v apt-get >/dev/null 2>&1; then
        pkgs=
        for c in $missing; do
            case "$c" in
                python3) pkgs="$pkgs python3" ;;
                curl) pkgs="$pkgs curl ca-certificates" ;;
                mkinitramfs) pkgs="$pkgs initramfs-tools" ;;
                grub-reboot)
                    if [ -d /sys/firmware/efi ]; then pkgs="$pkgs grub-efi"; else pkgs="$pkgs grub-pc"; fi ;;
            esac
        done
        echo "suggested install: sudo apt-get install -y$pkgs"
        if confirm "install the missing dependencies with apt-get now?"; then
            if ! $SUDO env DEBIAN_FRONTEND=noninteractive apt-get update -qq; then
                echo "dependency install failed" >&2; exit 1
            fi
            # Intentional word splitting: package names are a space-separated apt list.
            # shellcheck disable=SC2086
            $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y $pkgs || {
                echo "dependency install failed" >&2; exit 1; }
        else
            echo "cannot continue without dependencies" >&2; exit 1
        fi
    else
        echo "not an apt-based system; install the equivalents and re-run" >&2
        exit 1
    fi
fi
# install and rescue modes re-verify everything the run needs — a half-failed
# dependency install must surface here, not as a confusing error deep into
# staging. check mode is read-only: it reports missing staging dependencies
# but can still collect facts and produce a support verdict.
if [ "$cmd" = install ]; then
    needs_full_deps=1
elif [ "$cmd" = rescue ]; then
    needs_full_deps=1
else
    needs_full_deps=
fi
if [ -n "$needs_full_deps" ]; then
    for dep in python3 curl mkinitramfs; do
        command -v "$dep" >/dev/null 2>&1 || { echo "still missing: $dep" >&2; exit 1; }
    done
else
    command -v python3 >/dev/null 2>&1 || { echo "still missing: python3" >&2; exit 1; }
fi
grub_reboot=$(command -v grub-reboot || command -v grub2-reboot || true)
if [ -z "$grub_reboot" ] && [ -n "$needs_full_deps" ]; then
    echo "still missing: grub-reboot" >&2; exit 1
fi

fi

# --- facts + plan ---------------------------------------------------------------
work=$here/work
trap 'rm -rf "$work"' EXIT
mkdir -p "$work"

echo "==> collecting machine facts"
$SUDO "$here/engine/facts.sh" > "$work/facts" || { echo "facts collection failed" >&2; exit 1; }

host=$(sed -n 's/^hostname=//p' "$work/facts" | head -1)
firmware=$(sed -n 's/^firmware=//p' "$work/facts" | head -1)
boot_separate=$(sed -n 's/^boot_separate=//p' "$work/facts" | head -1)
if [ "$boot_separate" = yes ]; then
    grub_boot_prefix=
else
    grub_boot_prefix=/boot
fi
if [ "$cmd" = rescue ]; then
    echo "==> resolving rescue plan (offline; no manifest or OS artifact)"
    set -- --facts "$work/facts" --host "$host" --backend "$rescue_backend"
    if [ -n "$accept_risks" ]; then
        set -- "$@" --accept-risk "$accept_risks"
    fi
    python3 "$here/engine/preflight.py" rescue-plan "$@" > "$work/plan.json" || {
        echo "rescue plan resolution failed" >&2; exit 1; }
else
    if [ -n "$manifest_file" ]; then
        mfile=$manifest_file
    elif [ -f "$here/manifests/$manifest.json" ]; then
        mfile="$here/manifests/$manifest.json"
    elif [ -f "$here/manifests/$manifest.yml" ]; then
        mfile="$here/manifests/$manifest.yml"
    else
        echo "manifest not found: $manifest (looked in $here/manifests)" >&2; exit 2
    fi

    echo "==> resolving plan (manifest $manifest)"
    set -- --manifest "$mfile" --facts "$work/facts" --host "$host"
    if [ -n "$accept_risks" ]; then
        set -- "$@" --accept-risk "$accept_risks"
    fi
    if [ -n "$mirror" ]; then
        set -- "$@" --mirror "$mirror"
    fi
    python3 "$here/engine/preflight.py" plan "$@" > "$work/plan.json" || { echo "plan resolution failed" >&2; exit 1; }
fi

# --- key material: explicit, discovered, manifest-declared ----------------------
# authorized_keys lines only, comments/blank stripped, deduped across sources.
: > "$work/keys"
key_sources=
if [ -n "$key" ]; then
    "$here/engine/merge-key-files.sh" "$work/keys" "$key"
    key_sources="--key $key"
    if [ ! -s "$work/keys" ]; then
        echo "no valid public key lines found in $key" >&2; exit 2
    fi
else
    # carry forward exactly the access that already reaches this machine:
    # the invoking user's authorized_keys plus root's (when different). Public
    # keys are not secret; copying root's public key file into the work dir is
    # only a convenience for merge/dedupe and never exposes private material.
    : > "$work/root_authorized_keys"
    if [ "$(id -u)" != 0 ]; then
        $SUDO cat /root/.ssh/authorized_keys 2>/dev/null > "$work/root_authorized_keys" || true
    fi
    "$here/engine/merge-key-files.sh" "$work/keys" \
        "$HOME/.ssh/authorized_keys" "$work/root_authorized_keys"
    key_sources="carried forward from this machine's authorized_keys"
fi
carried_keys=$(awk 'END {print NR}' "$work/keys" 2>/dev/null || echo 0)
carried_keys=${carried_keys:-0}

if [ "$cmd" = rescue ]; then
    auth_summary=rescue
    if [ "$carried_keys" -eq 0 ] && [ -z "$console_only" ]; then
        echo "REFUSING: rescue mode has no SSH keys and --console-only was not passed — pass --key, ensure authorized_keys exists, or pass --console-only if you have provider console access" >&2
        exit 1
    fi
elif [ "$cmd" = check ]; then
    # auth-mode assessment in read-only check mode (install mode re-checks
    # after optional/desktop per-install password setup).
    auth_summary=$(python3 "$here/engine/auth-summary.py" "$work/plan.json" "$carried_keys")
    case "$auth_summary" in
        *FATAL*)
            echo "REFUSING: no authentication material exists for the reinstalled machine —" >&2
            echo "no --key, nothing in this machine's authorized_keys files, and the manifest" >&2
            echo "declares neither user keys nor a password. installing a machine you cannot" >&2
            echo "log into is never the intent. pass --key or fix the manifest users." >&2
            exit 1 ;;
    esac
fi

# --- read-only check mode -------------------------------------------------------
python3 - "$work/plan.json" <<'PY'
import json
import sys
p = json.load(open(sys.argv[1]))
artifact = p.get("artifact") or {}
digest = artifact.get("checksum") or artifact.get("sha256") or ""
alg = artifact.get("checksum_alg") or ("sha256" if digest else "")
if p.get("mode") != "rescue":
    print("source:")
    print(f"  url: {artifact.get('url') or '<netboot>'}")
    if artifact.get("source_index"):
        print(f"  index: {artifact['source_index']}")
    if digest:
        print(f"  checksum: {alg}:{digest}")
    if artifact.get("mirror_override"):
        print(f"  mirror_override: {artifact['mirror_override']} (operator override)")
print("support envelope:")
for probe in p.get("envelope") or []:
    print(f"  [{probe['status']:>4}] {probe['name']}: {probe['note']}")
accepted = p.get("accepted_risks") or []
if accepted:
    print(f"accepted_risks: {','.join(accepted)}")
PY
python3 "$here/engine/preflight.py" check --plan "$work/plan.json" || {
    echo "preflight check failed — see BLOCKER/ENVELOPE-FAIL lines above" >&2
    exit 1
}
if [ "$cmd" = check ]; then
    if [ -f "$here/engine/dhcp_probe.py" ]; then
        net_if=$(sed -n 's/^net_if=//p' "$work/facts" | head -1)
        net_mac=$(sed -n 's/^net_mac=//p' "$work/facts" | head -1)
        if [ -n "$net_if" ] && [ -n "$net_mac" ] && [ "$net_mac" != none ]; then
            dhcp_avail=$($SUDO python3 "$here/engine/dhcp_probe.py" \
                --iface "$net_if" --mac "$net_mac" --timeout 1.5 --retries 1 2>/dev/null || echo unknown)
            echo "dhcp_available: ${dhcp_avail:-unknown}"
        fi
    fi
    echo "check complete: machine facts, plan fit and envelope probed — nothing was mutated"
    exit 0
fi

if [ "$rescue_backend" = alpine-kexec ]; then
    # shellcheck source=engine/alpine-rescue-stage.sh
    . "$here/engine/alpine-rescue-stage.sh"
    exit 0
fi

# --- rescue review + non-destructive staging -----------------------------------
if [ "$cmd" = rescue ]; then
    python3 - "$work/plan.json" "$carried_keys" "$key_sources" "$console_only" <<'PY'
import json
import sys
p = json.load(open(sys.argv[1]))
carried = int(sys.argv[2])
sources = sys.argv[3]
console_only = bool(sys.argv[4])
print()
print("Rescue review:")
print(f"  host={p['host']} disk={p['facts']['disk_path']}"
      f" size={int(p['facts']['disk_size_bytes']) // (1024 ** 3)}GiB")
print(f"  fingerprint={p['fingerprint']}")
accepted = p.get("accepted_risks") or []
if accepted:
    print(f"  accepted_risks={','.join(accepted)} (explicit operator override)")
if carried:
    suffix = f" ({sources})" if sources else ""
    print(f"  ssh_rescue_keys={carried} key(s){suffix}")
elif console_only:
    print("  ssh_rescue_keys=none (console-only access explicitly acknowledged)")
print("  one_shot_grub=BOOTIE rescue (one-shot); prior OS remains the saved default")
print("  NON-DESTRUCTIVE: no OS image or write command will be staged; rebooting returns to the prior OS unchanged")
print()
print(f"Confirmation token: {p['approval']}")
PY
    approval=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["approval"])' "$work/plan.json")
    echo "Type the confirmation token exactly to authorize staging rescue mode:"
    prompt_read "" && typed_approval=$REPLY || typed_approval=
    [ "$typed_approval" = "$approval" ] || {
        echo "confirmation did not match; rescue staging was not run" >&2; exit 1; }

    echo "==> staging rescue environment"
    staging=/usr/local/share/bootie-rescue
    if [ -d "$staging" ]; then
        $SUDO rm -rf "$staging"
    fi
    $SUDO mkdir -p "$staging"

    # Dropbear initramfs keys go in BEFORE installing dropbear-initramfs so
    # the package hook sees valid authorized_keys on its first run. Empty key
    # material means the explicitly acknowledged console-only rescue path.
    if [ -s "$work/keys" ]; then
        if [ -d /etc/dropbear/initramfs ] || $SUDO mkdir -p /etc/dropbear/initramfs; then
            $SUDO cp "$work/keys" /etc/dropbear/initramfs/authorized_keys
            $SUDO chmod 600 /etc/dropbear/initramfs/authorized_keys
        fi
    fi

    pkgs=$(python3 -c 'import json,sys; print(" ".join(json.load(open(sys.argv[1]))["liveenv"].get("packages") or []))' "$work/plan.json")
    if [ -n "$pkgs" ]; then
        echo "installing rescue live env packages: $pkgs"
        if ! $SUDO env DEBIAN_FRONTEND=noninteractive apt-get update -qq; then
            echo "rescue live env package install failed" >&2; exit 1
        fi
        # Intentional word splitting: package names are a space-separated apt list.
        # shellcheck disable=SC2086
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y $pkgs || {
            echo "rescue live env package install failed" >&2; exit 1; }
    fi

    # Re-sync after package installation in case the package created or reset
    # /etc/dropbear/initramfs.
    if [ -s "$work/keys" ]; then
        if [ -d /etc/dropbear/initramfs ] || $SUDO mkdir -p /etc/dropbear/initramfs; then
            $SUDO cp "$work/keys" /etc/dropbear/initramfs/authorized_keys
            $SUDO chmod 600 /etc/dropbear/initramfs/authorized_keys
        fi
    fi

    # The rescue staging tree is deliberately separate from /usr/local/share/bootie:
    # no install plan.env, payload, liveenv write engine, or autostart is copied here.
    $SUDO cp "$here/engine/facts.sh" "$here/engine/rescue-helper.sh" "$staging/"
    $SUDO chmod 755 "$staging/facts.sh" "$staging/rescue-helper.sh"

    python3 - "$work/plan.json" > "$work/rescue.env" <<'PY'
import json
import sys

def q(value):
    return "'" + str(value).replace("'", "'\\''") + "'"

p = json.load(open(sys.argv[1]))
facts = p["facts"]
lines = [
    f"HOSTNAME_V={q(facts.get('hostname') or p.get('host') or '')}",
    f"PLAN_DISK={q(facts['disk_path'])}",
    f"FP_EXPECTED={q(p['fingerprint'])}",
    f"NET_IF={q(facts['net_if'])}",
    f"IPV4_ADDR={q(facts['ipv4_addr'])}",
