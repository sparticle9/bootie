#!/usr/bin/env bash
# bundle — build bootie, the self-extracting target-local reinstall script.
#
# Produces ONE file carrying the modular engine, manifests (pre-converted to
# JSON so the target needs no YAML library), static payloads and the target-side
# entrypoint. The payload rides as a quoted here-document, not a `tail $0`
# suffix, so both execution shapes work:
#
#   curl -LO https://github.com/sparticle9/bootie/releases/latest/download/bootie.sh && sh bootie.sh
#   curl -fsSL https://github.com/sparticle9/bootie/releases/latest/download/bootie.sh | sh
set -euo pipefail

cd "$(dirname "$0")/.."

out=${1:-bootie.sh}

[[ -d engine && -d manifests && -f bootie-main ]] || {
    echo "bundle must run from the bootie repository" >&2
    exit 1
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Version stamp — git identity of the tree the bundle was built from.
version=$(git describe --tags --always --dirty 2>/dev/null || echo "dev-$(date -u +%Y%m%d)")
echo "$version" > "$work/VERSION"

# Engine + entrypoint. The artifact keeps the source tree's modular layout so
# bootie-main resolves the same relative paths in both forms.
mkdir -p "$work/engine"
cp bootie-main "$work/"
cp engine/*.sh engine/*.py "$work/engine/"
chmod +x "$work/bootie-main" "$work/engine/"*.sh "$work/engine/"*.py 2>/dev/null || true

# Static payloads. Omarchy manifests use om-desktop when present; other
# manifests may ignore it.
mkdir -p "$work/payload"
cp payload/om-desktop "$work/payload/" 2>/dev/null || true

# Manifests pre-converted to JSON — the target's Python needs no YAML module.
python_cmd=()
if python3 -c 'import yaml' >/dev/null 2>&1; then
    python_cmd=(python3)
elif command -v uv >/dev/null 2>&1; then
    python_cmd=(uv run python)
else
    echo "bundle needs PyYAML importable by python3, or uv to provide it" >&2
    exit 1
fi
mkdir -p "$work/manifests"
for yml in manifests/*.yml; do
    name=$(basename "$yml" .yml)
    "${python_cmd[@]}" -c "
import json, sys, yaml
doc = yaml.safe_load(open(sys.argv[1]))
json.dump(doc, open(sys.argv[2], 'w'))
" "$yml" "$work/manifests/$name.json"
done

# Self-extracting envelope — POSIX sh, base64+tar only, heredoc payload.
{
    cat <<'EOF'
#!/bin/sh
# bootie — self-extracting target-resident reinstall bundle.
# Generated by scripts/bundle; do not edit (regenerate instead).
#
# usage on the machine being reinstalled:
#   sh bootie.sh              interactive review + typed approval, then
#                             everything unattended (reboot kills the
#                             session — expected)
#   sh bootie.sh check        read-only probe of facts/plan/envelope
#   sh bootie.sh version      print build identity
#   sh bootie.sh --help       commands and options
#
# key material is optional: without --key the keys already authorized on
# the machine are carried forward. Read SECURITY.md before real use.
set -e
# unique extraction dir — a re-run after a failed or interrupted pass must
# never refuse. debris in /tmp is irrelevant: the machine is about to be
# erased (in --no-reboot mode the operator can clean /tmp manually).
work=$(mktemp -d "${TMPDIR:-/tmp}/bootie.XXXXXX")
base64 -d <<'__BOOTIE_PAYLOAD__' | tar xz -C "$work" 2>/dev/null
EOF
    (cd "$work" && tar cz . | base64)
    cat <<'EOF'
__BOOTIE_PAYLOAD__
[ -f "$work/bootie-main" ] || {
    echo "corrupt bootie: extraction incomplete — partial or damaged download?" >&2
    exit 1
}
exec sh "$work/bootie-main" "$@"
exit 1
EOF
} > "$out"
chmod +x "$out"
echo "bootie written: $out ($(wc -c < "$out" | tr -d ' ') bytes, version $version)"
